# ============================================================================
# Ghaslet — single env file for both web and worker
# Copy to .env.local and fill in your values
# ============================================================================

# --- Postgres ----------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/ghaslet
# PGSSL=true
# PGPOOL_MAX=10

# --- Meta / Instagram Graph API ----------------------------------------------
INSTAGRAM_VERIFY_TOKEN=
META_APP_SECRET=
IG_USER_ID=
# GRAPH_API_VERSION=v24.0
# REPLY_TO_THREADED_COMMENTS=false

# --- Dashboard authentication ------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=

# --- AI (OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=
AI_MODEL=google/gemma-3-12b-it:free

# --- Playwright (worker only) ------------------------------------------------
PLAYWRIGHT_USER_DATA_DIR=./.playwright-profile
PLAYWRIGHT_HEADLESS=false
POLL_INTERVAL_MS=30000
# MAX_POLL_BACKOFF_MS=300000
# MAX_NOTIFICATION_SCROLLS=3
# ACTION_DELAY_MIN_MS=3000
# ACTION_DELAY_MAX_MS=12000
# PLAYWRIGHT_BACKFILL_ON_FIRST_RUN=true

# --- Global switches ---------------------------------------------------------
DRY_RUN=false
LOG_LEVEL=info
