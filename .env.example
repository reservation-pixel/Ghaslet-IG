# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Both the Next.js app and the Playwright
# worker read this file.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
# Required by both the Next.js app and the Playwright worker.
# Apply the schema with:  npm run db:migrate
DATABASE_URL=postgresql://user:password@localhost:5432/ghaslet
# PGSSL=true     # set for a hosted database that requires TLS
# PGPOOL_MAX=10

# --- Meta / Instagram Graph API -------------------------------------------
# User access token (not a Page token). Needs BOTH scopes:
#   instagram_business_manage_messages
#   instagram_business_manage_comments   <-- required for comment automation
INSTAGRAM_ACCESS_TOKEN=

# Any string you choose; must match the value entered in the Meta App Dashboard.
INSTAGRAM_VERIFY_TOKEN=

# Meta App Dashboard > App settings > Basic > App secret.
# When unset the webhook accepts unverified payloads and logs a warning.
META_APP_SECRET=

# Your Instagram Business account id. Required — without it the bot cannot tell
# its own comments from a user's and comment processing is disabled outright.
IG_USER_ID=

# Optional. Defaults to v24.0.
# GRAPH_API_VERSION=v24.0

# Act on replies-to-comments as well as top-level comments. Off by default.
# REPLY_TO_THREADED_COMMENTS=false

# --- Dashboard authentication ---------------------------------------------
# Signing key for access-token JWTs. REQUIRED — the dashboard can read and send
# Instagram DMs, so it must not be left open.
# Generate one with:  openssl rand -base64 48
# Changing it signs everyone out immediately.
AUTH_JWT_SECRET=

# The superadmin defaults to admin@ghaslet.local, defined in
# src/lib/auth/superadmin.ts. Its row is created automatically on the first
# login attempt — there is no seed step.
#
# All three override those defaults. Set them in .env.local, NOT here:
# this file is committed to git (see the `!.env.example` rule in .gitignore),
# and it is never read at runtime.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=

# --- AI (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
AI_MODEL=google/gemma-3-12b-it:free

# --- Playwright worker ----------------------------------------------------
PLAYWRIGHT_USER_DATA_DIR=./.playwright-profile
# Set to false for `npm run worker:login`; the login script forces headful anyway.
PLAYWRIGHT_HEADLESS=true
POLL_INTERVAL_MS=30000
MAX_POLL_BACKOFF_MS=300000
MAX_NOTIFICATION_SCROLLS=3
ACTION_DELAY_MIN_MS=3000
ACTION_DELAY_MAX_MS=12000

# Record (but do not act on) everything visible on the first ever poll.
# Turning this off will DM every historical follower. Leave it on.
PLAYWRIGHT_BACKFILL_ON_FIRST_RUN=true

# --- Global switches ------------------------------------------------------
# true = decide and log everything, send nothing. Use this for first runs.
DRY_RUN=false
LOG_LEVEL=info
