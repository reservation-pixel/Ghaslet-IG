# --- Postgres (Render Internal URL) --------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/ghaslet
# PGSSL=true
# PGPOOL_MAX=10

# --- Meta / Instagram Graph API ------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
META_APP_SECRET=
IG_USER_ID=
# GRAPH_API_VERSION=v24.0
# REPLY_TO_THREADED_COMMENTS=false

# --- Dashboard authentication --------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=

# --- AI (OpenRouter) -----------------------------------------------------
OPENROUTER_API_KEY=
AI_MODEL=google/gemma-3-12b-it:free

# --- Global switches -----------------------------------------------------
DRY_RUN=false
LOG_LEVEL=info
