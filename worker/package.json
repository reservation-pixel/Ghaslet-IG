{
  "name": "ghaslet-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "worker:login": "tsx src/worker/index.ts --login",
    "worker:once": "tsx src/worker/index.ts --once --dry-run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:status": "tsx src/scripts/migrate.ts --status",
    "postinstall": "npx playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.33.0",
    "pg": "^8.22.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3"
  }
}
